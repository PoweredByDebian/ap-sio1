#
# ap06/check : fait le point sur l'atelier « Mon radar » (la veille technologique, dans le portfolio de l'ap05).
#   sudo ./check       toutes les missions
#   sudo ./check 6     la mission 6 seulement
# Ne modifie rien sur la machine.
. "$(dirname "$(readlink -f "$0")")/../lib/check.sh"
need_root

ONLY="${1:-}"
case "$ONLY" in ""|[1-9]|10) ;; *) echo "Usage : sudo ./check [1-10]"; exit 2 ;; esac
U="${SUDO_USER:-$(logname 2>/dev/null)}"
H="$(getent passwd "$U" | cut -d: -f6)"
R="$H/rapport-ap06.txt"
O="$H/abonnements.opml"
W=/var/www/wordpress          # le portfolio de l'ap05
CF="$W/wp-config.php"

# L'alerte de la mission 3 : empreintes (sha256, en minuscules, sans espaces) de la CVE et de la version qui la corrige.
# Pour changer d'alerte : printf '%s' cve-aaaa-nnnnn | sha256sum
ALERT_CVE=67737d4c42ad8301b35c5af9d9259edfc8626a8e136cd61d5338ae7d11cf5839
ALERT_FIX=327c740fb0330528b4dd4afd1ea7f32129ac9e2ebf14224c6702f87943006962

# Sources d'origine (celui qui produit l'information : autorité, éditeur ou projet, dépôt de code).
# Un flux de l'OPML, ou un lien d'un article, est « d'origine » si son hôte se termine par l'un de ces domaines.
# La liste ne peut pas tout connaître : une source d'origine absente de la liste compte aussi si elle est
# signalée « origine » dans le tableau « Mes sources » de la page Ma veille (mission 8).
ORIGIN='gouv\.fr|gov|gov\.uk|europa\.eu|cve\.org|mitre\.org|first\.org|cnil\.fr|wordpress\.org|github\.com|gitlab\.com|codeberg\.org|debian\.org|ubuntu\.com|redhat\.com|kernel\.org|php\.net|python\.org|nodejs\.org|apache\.org|mariadb\.org|mysql\.com|postgresql\.org|nginx\.org|mozilla\.org|w3\.org|microsoft\.com|apple\.com|cisco\.com|fortinet\.com|vmware\.com|proxmox\.com|docker\.com|kubernetes\.io|android\.com|chromium\.org|googleblog\.com'

# ---------- outils ----------
raw()  { grep -m1 "^$1=" "$R" 2>/dev/null | cut -d= -f2- | sed -E 's/^[[:space:]]+|[[:space:]]+$//g'; }
val()  { raw "$1" | tr -d '[:space:]'; }
# en minuscules, sans accents ni espaces : « Corrigé » → corrige
flat() { raw "$1" | sed 's/É/e/g; s/È/e/g; s/é/e/g; s/è/e/g; s/ê/e/g; s/ë/e/g; s/à/a/g; s/ç/c/g' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]'; }
run()  { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }
T="$(sed -nE "s/^\\\$table_prefix *= *['\"]([A-Za-z0-9_]+)['\"].*/\1/p" "$CF" 2>/dev/null | head -1)"
T="${T:-wp_}"
# -r : vrais sauts de ligne dans post_content ; utf8mb4 : accents justes, quelle que soit la locale de sudo
sql()  { mariadb --default-character-set=utf8mb4 -NBre "$1" portfolio 2>/dev/null; }
opt()  { sql "SELECT option_value FROM ${T}options WHERE option_name='$1'"; }
num()  { [ "$(sql "$1")" -ge "$2" ] 2>/dev/null; }
# WordPress redirige une page demandée sous un autre nom que celui de l'installation :
# on la demande donc à Apache en local, avec l'hôte du site (Host:).
host() { opt home | sed -E 's#^https?://([^/]+).*#\1#'; }
web()  { curl -s --max-time 15 -H "Host: $(host)" "http://127.0.0.1$1"; }
code() { curl -s -o /dev/null --max-time 15 -w '%{http_code}' -H "Host: $(host)" "http://127.0.0.1$1"; }
wpver(){ sed -nE "s/^\\\$wp_version *= *'([^']+)'.*/\1/p" "$W/wp-includes/version.php" 2>/dev/null; }

# page « Ma veille » ; sect "Titre" = le texte de la section qui suit ce titre, jusqu'au titre suivant (sans balises)
page() { sql "SELECT post_content FROM ${T}posts WHERE post_type='page' AND post_status='publish' AND post_name='ma-veille' ORDER BY ID DESC LIMIT 1"; }
sect() { page | awk -v t="$1" '/<h[1-6][^>]*>/ { on = index($0, t) > 0; next } on' | sed -E 's/<[^>]+>//g'; }
table(){ page | awk -v n="$1" 'BEGIN{RS="<!-- wp:table"} NR==n+1'; }
rows() { table "$1" | grep -o '<tr' | wc -l; }
# abonnements.opml : nombre de flux (hors portfolios du campus), nombre de dossiers (un dossier = un <outline> qui contient des flux)
opml() { php -r '$x = @simplexml_load_file($argv[1]); if (!$x) exit(1);
                 echo count($x->xpath("//outline[@xmlUrl and not(contains(@xmlUrl, \"/portfolio/\"))]")), " ", count($x->xpath("//outline[outline[@xmlUrl]]"));' "$O" 2>/dev/null; }
# hôtes des flux de l'OPML qui sont des sources d'origine (un par hôte)
origins() { grep -oiE 'xmlUrl="https?://[^/":]+' "$O" 2>/dev/null | sed -E 's#^xmlUrl="https?://##I' | tr '[:upper:]' '[:lower:]' \
            | grep -E "(^|\.)($ORIGIN)$" | sort -u; }
# adresses des flux de catégorie Veille d'autres portfolios que le sien (les camarades, mission 10)
peers() { grep -oiE 'xmlUrl="https?://[^/"]+/portfolio/category/veille/feed/?"' "$O" 2>/dev/null \
          | sed -E 's#^xmlUrl="https?://([^/"]+)/.*#\1#I' | grep -vFx "$(host)" | sort -u; }

# articles publiés de la catégorie Veille ; « alerte » = ceux qui portent l'étiquette alerte, « note » = les autres
veille="FROM ${T}posts p JOIN ${T}term_relationships r ON r.object_id=p.ID JOIN ${T}term_taxonomy x ON x.term_taxonomy_id=r.term_taxonomy_id
        JOIN ${T}terms t ON t.term_id=x.term_id WHERE p.post_type='post' AND p.post_status='publish' AND x.taxonomy='category' AND t.slug='veille'"
tagged="SELECT r2.object_id FROM ${T}term_relationships r2 JOIN ${T}term_taxonomy x2 ON x2.term_taxonomy_id=r2.term_taxonomy_id
        JOIN ${T}terms t2 ON t2.term_id=x2.term_id WHERE x2.taxonomy='post_tag' AND t2.slug='alerte'"
alert_id() { sql "SELECT p.ID $veille AND p.ID IN ($tagged) ORDER BY p.ID DESC LIMIT 1"; }
note_id()  { sql "SELECT p.ID $veille AND p.ID NOT IN ($tagged) ORDER BY p.ID DESC LIMIT 1"; }
content()  { [ -n "$1" ] && sql "SELECT post_content FROM ${T}posts WHERE ID=$1"; }
# liens d'un article vers d'autres sites que le portfolio : un hôte par ligne
xhosts()   { local h; h="$(host)"; content "$1" | grep -oE 'href="https?://[^/":]+' | sed -E 's#^href="https?://##' \
             | tr '[:upper:]' '[:lower:]' | grep -vFx "$h" | sort -u; }
xlinks()   { local h; h="$(host)"; content "$1" | grep -oE 'href="https?://[^"]+"' | grep -v "//$h[/:\"]" | sort -u | wc -l; }
# l'article est dans le flux de la catégorie Veille (repéré par son slug, dans <link>)
infeed()   { local s; s="$(sql "SELECT post_name FROM ${T}posts WHERE ID=${1:-0}")"; [ -n "$s" ] && web /portfolio/category/veille/feed/ | grep -q "/$s/<"; }
urlhost()  { raw "$1" | sed -nE 's#^https?://([^/:]+).*#\1#p' | tr '[:upper:]' '[:lower:]'; }

# ---------- contrôles ----------
c_installed() { [ -n "$(opt siteurl)" ]; }
c_site()      { c_installed && [ "$(code /portfolio/)" = 200 ]; }

c_domain()    { [ -n "$(val domaine)" ]; }
c_theme()     { [ -n "$(val theme)" ]; }
c_question()  { local q; q="$(raw question)"; [ "$(echo "$q" | wc -w)" -ge 5 ] && echo "$q" | grep -q '?[[:space:]]*$'; }
c_keywords()  { [ "$(raw mots_cles | tr ',;' '\n\n' | grep -c '[[:alnum:]]')" -ge 5 ]; }

c_cve()       { answer "$(raw cve)" "$ALERT_CVE"; }
c_fix()       { answer "$(raw corrige_en)" "$ALERT_FIX"; }
c_myver()     { [ -n "$(wpver)" ] && [ "$(val ma_version)" = "$(wpver)" ]; }
# le verdict attendu se déduit de la version installée et de la version corrigée (déjà validée par c_fix)
c_verdict()   { local f v; c_fix && c_myver || return 1; f="$(val corrige_en)"; v="$(wpver)"
                if dpkg --compare-versions "$v" lt "$f"; then [ "$(flat verdict)" = concerne ]; else [ "$(flat verdict)" = corrige ]; fi; }
c_cat()       { num "SELECT COUNT(*) FROM ${T}terms t JOIN ${T}term_taxonomy x ON x.term_id=t.term_id WHERE x.taxonomy='category' AND t.slug='veille'" 1; }
c_alert()     { [ -n "$(alert_id)" ]; }
c_alertcve()  { content "$(alert_id)" | grep -qE 'CVE-[0-9]{4}-[0-9]{4,}'; }
c_alertsrc()  { xhosts "$(alert_id)" | grep -qE "(^|\.)($ORIGIN)$"; }
c_alertfill() { local c; c="$(content "$(alert_id)")"; [ -n "$c" ] && echo "$c" | grep -q 'verdict' \
                && ! echo "$c" | grep -qE "\((la faille|les versions touchées|concerné, pas concerné|le bulletin)"; }

c_feed()      { web /portfolio/feed/ | grep -q '<rss'; }
c_catfeed()   { infeed "$(alert_id)"; }

c_opml()      { opml >/dev/null; }
c_feeds()     { local n; n="$(opml)" && [ "${n% *}" -ge 6 ]; }
c_folders()   { local n; n="$(opml)" && [ "${n#* }" -ge 2 ]; }
c_markedorig(){ [ "$(table 1 | sed -E 's/<[^>]+>/\n/g' | grep -ciE '^[[:space:]]*origine')" -ge 2 ]; }
c_origin()    { [ "$(origins | grep -c .)" -ge 2 ] || c_markedorig; }
c_opmlown()   { [ "$(stat -c %U "$O" 2>/dev/null)" = "$U" ]; }

c_kept()      { [ "$(grep -E '^garde=[[:space:]]*https?://[^[:space:]]+' "$R" 2>/dev/null | sed 's/[[:space:]]//g' | sort -u | wc -l)" -ge 3 ]; }

c_orig()      { [ -n "$(urlhost origine)" ]; }
c_confirm()   { [ -n "$(urlhost confirmation)" ] && [ "$(urlhost confirmation)" != "$(urlhost origine)" ]; }
c_crossed()   { [ -n "$(val recoupement)" ]; }

c_page()      { [ -n "$(page)" ]; }
c_pquestion() { sect 'Ma question' | grep -q '?' && ! sect 'Ma question' | grep -qE '\((ta question|ton domaine|ton thème)'; }
c_pkeywords() { local k; k="$(sect 'Mes mots-cl')"; ! echo "$k" | grep -q '(tes ' && [ "$(echo "$k" | tr ',;' '\n\n' | grep -c '[[:alnum:]]')" -ge 5 ]; }
c_sources()   { [ "$(rows 1)" -ge 7 ] && ! table 1 | grep -qE '\((nom de la source|origine ou relais|origine :|adresse du flux|ce qu.elle)'; }
c_state()     { local s; s="$(sect 'tat de')"; ! echo "$s" | grep -qE '\((date|ce que tu sais|une deuxi)' \
                && echo "$s" | grep -qiE '[0-9]{1,2}/[0-9]{1,2}/20[0-9]{2}|20[0-9]{2}-[0-9]{2}-[0-9]{2}|[0-9]{1,2}(er)? (janvier|f[^ ]{1,2}vrier|mars|avril|mai|juin|juillet|ao[^ ]{1,2}t|septembre|octobre|novembre|d[^ ]{1,2}cembre) 20[0-9]{2}'; }
c_latest()    { local id; id="$(sql "SELECT t.term_id FROM ${T}terms t JOIN ${T}term_taxonomy x ON x.term_id=t.term_id WHERE x.taxonomy='category' AND t.slug='veille' LIMIT 1")"
                [ -n "$id" ] && page | grep -E 'wp:latest-posts' | grep -qE "\"categories\":\[[^]]*\"id\":$id[,}]"; }
c_menu()      { web /portfolio/ | grep -q '/portfolio/ma-veille/'; }

c_note()      { [ -n "$(note_id)" ]; }
c_notemodel() { local c; c="$(content "$(note_id)")"; echo "$c" | grep -q 'Quoi' && echo "$c" | grep -q 'Et alors' && echo "$c" | grep -q 'Et maintenant' \
                && ! echo "$c" | grep -qE "\((ce qui est nouveau|pour qui c.est|ce que tu proposes|source d.origine :|confirmation :)"; }
c_link2()     { [ "$(xlinks "$(note_id)")" -ge 2 ]; }
c_tags()      { local id; id="$(note_id)"; [ -n "$id" ] && num "SELECT COUNT(*) FROM ${T}term_relationships r JOIN ${T}term_taxonomy x ON x.term_taxonomy_id=r.term_taxonomy_id WHERE r.object_id=$id AND x.taxonomy='post_tag'" 1; }
c_notefeed()  { infeed "$(note_id)"; }

c_peers()     { [ "$(peers | grep -c .)" -ge 2 ]; }
c_moderated() { [ "$(sql "SELECT COUNT(*) FROM ${T}comments WHERE comment_approved='0'")" = 0 ]; }


# ---------- missions ----------
title "Mon radar · ap06 · compte $U"

if run 1; then
  mission "Mission 1 : reprendre la main"
  check "Apache tourne toujours" systemctl is-active -q apache2
  hint "sudo systemctl start apache2"
  check "MariaDB tourne toujours" systemctl is-active -q mariadb
  hint "sudo systemctl start mariadb"
  check "ton portfolio de l'ap05 répond" c_site
  hint "ouvre http://<IP de ta VM>/portfolio/ : si rien ne s'affiche, relance sudo ~/ap-sio1/ap05/check"
fi

if run 2; then
  mission "Mission 2 : ma question de veille"
  check "rapport : domaine" c_domain
  hint "echo \"domaine=…\" >> ~/rapport-ap06.txt"
  check "rapport : theme" c_theme
  hint "echo \"theme=…\" >> ~/rapport-ap06.txt (sans accent sur le mot theme)"
  check "rapport : question (une vraie phrase, qui finit par ?)" c_question
  hint "echo \"question=… ?\" >> ~/rapport-ap06.txt"
  check "rapport : mots_cles (5 au moins, séparés par des virgules)" c_keywords
  hint "des noms précis : produits, versions, sigles (ex. WordPress, extension, CVE, mise à jour, PHP 8.4)"
fi

if run 3; then
  mission "Mission 3 : remonter à la source"
  check "rapport : cve, le bon numéro" c_cve
  hint "le numéro est dans l'avis du CERT-FR et dans le bulletin de WordPress : CVE-AAAA-NNNNN"
  check "rapport : corrige_en, la bonne version" c_fix
  hint "la première version de la branche 7.1 qui contient le correctif, sous la forme 7.1.x"
  check "rapport : ma_version, celle de ton portfolio" c_myver
  hint "grep wp_version /var/www/wordpress/wp-includes/version.php"
  check "rapport : verdict, juste pour ta version" c_verdict
  hint "compare ma_version et corrige_en : concerné, pas concerné ou corrigé ?"
  check "la catégorie Veille existe" c_cat
  hint "tableau de bord : Articles › Catégories, nom Veille"
  check "une alerte publiée : catégorie Veille, étiquette alerte" c_alert
  hint "panneau Article : Catégories › Veille, Étiquettes › alerte ; puis Publier"
  check "l'alerte est complétée et donne ton verdict" c_alertfill
  hint "colle pages/alerte.txt (Raw) avec Ctrl+Maj+V, puis remplace chaque texte entre parenthèses"
  check "l'alerte cite le numéro de CVE" c_alertcve
  check "l'alerte renvoie à une source d'origine (lien)" c_alertsrc
  hint "un lien (Ctrl+K) vers le bulletin de l'éditeur ou l'avis du CERT-FR, pas vers un site d'actualité"
fi

if run 4; then
  mission "Mission 4 : le flux de ton portfolio"
  check "ton portfolio publie son flux (/portfolio/feed/)" c_feed
  hint "curl -sL http://<IP de ta VM>/portfolio/feed/ | head -20"
  check "le flux de la catégorie Veille contient ton alerte" c_catfeed
  hint "curl -sL http://<IP de ta VM>/portfolio/category/veille/feed/ | grep '<title>'"
fi

if run 5; then
  mission "Mission 5 : mon lecteur, mes abonnements"
  check "~/abonnements.opml est arrivé, et c'est un OPML lisible" c_opml
  hint "exporte tes abonnements en OPML, puis depuis ton poste : scp <fichier exporté> $U@<IP de ta VM>:abonnements.opml"
  check "6 flux au moins dans tes abonnements (sans compter les portfolios du campus)" c_feeds
  hint "abonne-toi à d'autres flux, puis exporte et copie à nouveau l'OPML"
  check "2 dossiers au moins (tes flux sont rangés)" c_folders
  hint "range tes flux dans des dossiers de ton compte de flux, puis exporte à nouveau"
  check "2 sources d'origine au moins (autorité, éditeur, projet, dépôt)" c_origin
  hint "par exemple le CERT-FR, l'éditeur de ton logiciel, ses versions sur GitHub ; si ./check ne la reconnaît pas, signale-la « origine » dans ta page Ma veille (mission 8)"
  check "abonnements.opml est à ton compte" c_opmlown
  hint "copie-le avec ton compte (scp), pas avec sudo"
fi

if run 6; then
  mission "Mission 6 : trier en 10 secondes"
  check "rapport : 3 articles gardés (garde=adresse, une ligne chacun)" c_kept
  hint "echo 'garde=https://…' >> ~/rapport-ap06.txt (l'adresse entre apostrophes), trois fois, trois adresses différentes"
fi

if run 7; then
  mission "Mission 7 : vérifier avant de croire"
  check "rapport : origine, l'adresse de l'annonce d'origine" c_orig
  hint "echo 'origine=https://…' >> ~/rapport-ap06.txt"
  check "rapport : confirmation, l'adresse d'une source sur un autre site" c_confirm
  hint "une source indépendante : un autre site que celui de l'annonce d'origine"
  check "rapport : recoupement, ton verdict" c_crossed
  hint "echo \"recoupement=confirmée : …\" >> ~/rapport-ap06.txt"
fi

if run 8; then
  mission "Mission 8 : ma page « Ma veille »"
  check "page « Ma veille » publiée" c_page
  hint "Pages › Ajouter une page, titre exact : Ma veille ; colle pages/ma-veille.txt (Raw) avec Ctrl+Maj+V ; puis Publier"
  check "ta question de veille, complétée" c_pquestion
  hint "sous « Ma question de veille » : ta question, qui finit par ?"
  check "tes mots-clés : 5 au moins" c_pkeywords
  check "tes sources : un tableau de 6 lignes au moins, complété" c_sources
  hint "une ligne par source ; pour ajouter une ligne : Modifier le tableau › Insérer une ligne après"
  check "tes sources : 2 au moins signalées « origine »" c_markedorig
  hint "colonne « Origine ou relais » : écris origine pour l'éditeur, le projet, le dépôt ou l'autorité"
  check "ton état de l'art : une ligne datée au moins" c_state
  hint "une date (12/11/2026), puis ce que tu sais aujourd'hui sur ta question"
  check "un bloc Derniers articles, filtré sur la catégorie Veille" c_latest
  hint "/derniers, bloc Derniers articles ; panneau de droite : Filtres › Catégories › Veille"
  check "le site montre « Ma veille » (lien dans le menu)" c_menu
  hint "si ton thème impose son menu, ajoute la page dans Apparence › Éditeur"
fi

if run 9; then
  mission "Mission 9 : ma première note de veille"
  check "une note publiée dans la catégorie Veille (sans l'étiquette alerte)" c_note
  hint "Articles › Ajouter un article ; Catégories › Veille, décoche Non classé ; puis Publier"
  check "Quoi ? Et alors ? Et maintenant ? complétés" c_notemodel
  hint "colle pages/note-de-veille.txt (Raw) avec Ctrl+Maj+V, puis remplace chaque texte entre parenthèses"
  check "deux sources citées par un lien vers deux autres sites" c_link2
  hint "sélectionne le nom de la source, Ctrl+K, colle l'adresse ; une pour l'origine, une pour la confirmation"
  check "des étiquettes sur la note" c_tags
  hint "panneau Article › Étiquettes : tes mots-clés, séparés par des virgules"
  check "le flux de la catégorie Veille contient ta note" c_notefeed
  hint "http://<IP de ta VM>/portfolio/category/veille/feed/"
fi

if run 10; then
  mission "Mission 10 : lire ses camarades"
  check "abonné aux notes de veille de deux camarades" c_peers
  hint "dossier Ma promo : http://<IP du camarade>/portfolio/category/veille/feed/, puis exporte et copie à nouveau l'OPML"
  check "aucun commentaire en attente de modération" c_moderated
  hint "tableau de bord : Commentaires, Approuver (ou Indésirable pour un message qui n'a rien à faire là)"
fi

if [ -n "$ONLY" ]; then finish "Mission $ONLY validée : passe à la suivante."; fi
finish "Toutes les missions sont validées : exit 0. Appelle le professeur."
